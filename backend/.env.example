# =========================================================
# 本機開發環境變數 — 對應 application.yml 裡的 ${VAR:default}
# 本檔案含有密鑰／密碼，不要提交進版控，請確認 .gitignore 有排除 .env
# =========================================================
 
# ------- MySQL -------
DB_URL=jdbc:mysql://localhost:3306/carwash_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Taipei
DB_USERNAME=root
DB_PASSWORD=your_password
 
# ------- JWT -------
# 正式環境請換成隨機字串，至少 32 bytes（HS256 要求），產生範例：openssl rand -base64 32
JWT_SECRET=dev-only-CHANGE_THIS_TO_A_RANDOM_32BYTE_SECRET_BEFORE_DEPLOY
 
# ------- Redis -------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
 
# ------- MinIO -------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
 
# ------- Server -------
SERVER_PORT=8081

# --------Mail-------
GMAIL_USERNAME=
GMAIL_PASSWORD=