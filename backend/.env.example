# =========================================================
# 本機開發環境變數 — 對應 application.yml 裡的 ${VAR:default}
# 本檔案含有密鑰／密碼，不要提交進版控，請確認 .gitignore 有排除 .env
# =========================================================
 
# ------- MySQL -------
DB_URL=jdbc:mysql://localhost:3306/carwash_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Taipei
DB_USERNAME=root
DB_PASSWORD=your_password
 
# ------- JWT -------
# 正式環境請換成隨機字串，至少 32 bytes（HS256 要求），產生範例：openssl rand -base64 32
JWT_SECRET=dev-only-CHANGE_THIS_TO_A_RANDOM_32BYTE_SECRET_BEFORE_DEPLOY
 
# ------- Redis -------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
 
# ------- MinIO -------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
 
# ------- Server -------
SERVER_PORT=8081

# ------- 安全相關 -------
# 允許呼叫 API 的前端網域（逗號分隔）。正式環境若網域不同於預設值請務必設定
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://gta-ch.edwardforce.tw
# Swagger 預設關閉；本機開發才設 true，正式環境不要開
SWAGGER_ENABLED=true
# 是否印出 SQL（本機除錯用，正式環境保持 false）
JPA_SHOW_SQL=false
# JWT 有效期（毫秒）：會員預設 24 小時、後台預設 8 小時
# JWT_EXPIRATION_MS=86400000
# JWT_ADMIN_EXPIRATION_MS=28800000

# --------Mail-------
GMAIL_USERNAME=
GMAIL_PASSWORD=

# ------- 前端網址（含 /carwash 路徑；優惠券通知信的連結會用到，正式環境例如 https://gta-ch.edwardforce.tw/carwash）-------
APP_BASE_URL=http://localhost:5174/carwash

# ------- 藍新金流（測試商店資料請至 https://cwww.newebpay.com 申請）-------
# HashKey 為 32 字元、HashIV 為 16 字元；returnUrl/notifyUrl 要是公開網址（本機用 ngrok）
NEWEBPAY_MERCHANT_ID=
NEWEBPAY_HASH_KEY=
NEWEBPAY_HASH_IV=
NEWEBPAY_RETURN_URL=https://your-public-host/api/payments/newebpay/return
NEWEBPAY_NOTIFY_URL=https://your-public-host/api/payments/newebpay/notify
APP_BASE_URL=https://gta-ch.edwardforce.tw/carwash
