# =========================================================
# docker-compose.yml 使用的變數
# 複製成 .env 後修改：  copy .env.example .env   （PowerShell：Copy-Item .env.example .env）
# .env 含密碼，不要提交進 git（根目錄 .gitignore 已排除）
# 後端的 JWT、Gmail、藍新金流等設定仍放在 backend/.env
# =========================================================

# MySQL root 密碼（容器內的資料庫，跟你 Windows 上的 MySQL 無關）
MYSQL_ROOT_PASSWORD=change_me_mysql

# Redis 密碼
REDIS_PASSWORD=change_me_redis

# MinIO 帳密（至少 8 個字元）
MINIO_ROOT_USER=carwash
MINIO_ROOT_PASSWORD=change_me_minio

# 網站對外埠號 → http://localhost:8080/carwash/
WEB_PORT=8080

# 前端網址（優惠券通知信的連結會用到），正式環境例如 https://gta-ch.edwardforce.tw/carwash
APP_BASE_URL=http://localhost:8080/carwash

# 允許的前端網域（逗號分隔，不含路徑）
CORS_ALLOWED_ORIGINS=http://localhost:8080,https://gta-ch.edwardforce.tw

# 本機想看 Swagger 時設 true，再把 backend 的 ports 打開，網址 http://localhost:8081/swagger-ui.html
SWAGGER_ENABLED=false
